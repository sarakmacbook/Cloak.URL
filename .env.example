# Cloak.URL configuration — copy to .env and edit:
#
#     cp .env.example .env
#     docker compose up -d --build
#
# `install.sh` writes this file for you (with mode 600, since it can hold a
# Cloudflare token).

# Stable project/container names, no matter what the folder is called
# (a ZIP download gives you "Cloak.URL-main", git gives you "Cloak.URL").
COMPOSE_PROJECT_NAME=cloak-url

# Host port the app listens on (the container always uses 3000).
PORT=3000

# 127.0.0.1 = private, reachable only via tunnel/nginx on this machine.
# 0.0.0.0   = reachable from your LAN / the internet directly.
BIND_ADDR=127.0.0.1

# Used to build the short links the API returns.
# http://localhost:3000 for local testing, https://yourdomain.com in production.
BASE_URL=http://localhost:3000

MAX_LINKS=10000

# Where the SQLite database lives:
#   ./data                → project folder (default; easy to back up)
#   cloak-data            → Docker named volume (survives container deletion)
#   /var/lib/cloak-url    → any absolute path
DB_MOUNT=./data

# Name of the Docker volume used when DB_MOUNT=cloak-data
DB_VOLUME_NAME=cloak-url-data

# ── Cloudflare Tunnel (optional) ────────────────────────────────────────────
# Get a token: one.dash.cloudflare.com → Networks → Tunnels → Create → Docker
# Leave TUNNEL_TOKEN empty to skip the tunnel (nginx or local-only use).
TUNNEL_TOKEN=

# Set to "tunnel" to actually start the tunnel service.
# install.sh does this automatically when you provide a token.
COMPOSE_PROFILES=
